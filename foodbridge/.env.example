# Copy to ".env" and edit. Never commit the real .env file.
APP_ENV=development
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-value
# Default: SQLite file in the instance/ folder
# DATABASE_URL=sqlite:///foodbridge.db
APP_TIMEZONE=Asia/Kolkata
MAX_PICKUP_WINDOW_HOURS=168

# Used only by "flask --app run create-admin" (you are prompted if unset)
# ADMIN_EMAIL=admin@example.com
# ADMIN_NAME=FoodBridge Admin
# ADMIN_PASSWORD=choose-a-strong-password

# Optional: password for the sample accounts created by "seed-demo"
# DEMO_PASSWORD=Demo@1234
